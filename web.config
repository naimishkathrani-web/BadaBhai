<?xml version="1.0" encoding="UTF-8"?>
<!-- Optional IIS URL Rewrite rules (this host serves via Nginx→Uvicorn; FastAPI also redirects .html). -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="how-it-works" stopProcessing="true">
          <match url="^how-it-works$" />
          <action type="Rewrite" url="how-it-works.html" />
        </rule>
        <rule name="gig-work" stopProcessing="true">
          <match url="^gig-work$" />
          <action type="Rewrite" url="gig-work.html" />
        </rule>
        <rule name="future" stopProcessing="true">
          <match url="^future$" />
          <action type="Rewrite" url="future.html" />
        </rule>
        <rule name="commitment" stopProcessing="true">
          <match url="^commitment$" />
          <action type="Rewrite" url="commitment.html" />
        </rule>
        <rule name="architecture" stopProcessing="true">
          <match url="^architecture$" />
          <action type="Rewrite" url="architecture.html" />
        </rule>
        <rule name="backup-demo" stopProcessing="true">
          <match url="^backup-demo$" />
          <action type="Rewrite" url="backup-demo.html" />
        </rule>
        <rule name="dashboard" stopProcessing="true">
          <match url="^dashboard$" />
          <action type="Rewrite" url="http://127.0.0.1:8000/dashboard" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
