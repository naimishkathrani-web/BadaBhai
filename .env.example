# Paste your dev.meta.ai key here. Never commit .env.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_CHAT_MODEL=muse-wonder-1.0
# Medium reasoning needs headroom; spoken answers stay short via the prompt.
META_MAX_TOKENS=1200
META_REASONING_EFFORT=medium
META_LOOKUP_REASONING_EFFORT=medium
META_LOOKUP_MAX_TOKENS=1600
META_ASR_MODEL=muse-voice-transcribe-1.0
META_ASR_URL=wss://api.meta.ai/v1/asr/realtime
# Generated locally: protects chat, speech and Exotel connections.
APP_TOKEN=replace-with-a-long-random-token
MAX_CALL_SECONDS=900
# Use echo only for testing Exotel connectivity without Meta or voice downloads.
CALL_MODE=meta
PREWARM_VOICES=1
MMS_TORCH_THREADS=4
MAX_CONCURRENT_CALLS=1
# Deliberately public hackathon judge line. Replace only if the test number changes.
JUDGES_PUBLIC_PHONE_E164=+917948504917
JUDGES_PUBLIC_VIDEO_URL=https://scrimba.com/explain/guide0gn7k887i?claim=ajpca04sa0c5tjqh&fullscreen=1
# Exotel call details API is used to retrieve the completed call recording.
EXOTEL_API_BASE_URL=https://api.in.exotel.com
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=

# Private PostgreSQL archive. Install PostgreSQL client tools (psql) on Windows.
PSQL_PATH=psql
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=badabhai
PGUSER=badabhai_app
PGPASSWORD=
CALL_RETENTION_DAYS=30
MAX_RECORDING_BYTES=26214400
