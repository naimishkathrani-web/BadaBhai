# Paste your dev.meta.ai key here. Never commit .env.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_CHAT_MODEL=muse-spark-1.3
META_MAX_TOKENS=1500
META_REASONING_EFFORT=minimal
META_ASR_MODEL=muse-voice-transcribe-1.0
META_ASR_URL=wss://api.meta.ai/v1/asr/realtime
# Generated locally: protects chat, speech and Exotel connections.
APP_TOKEN=replace-with-a-long-random-token
MAX_CALL_SECONDS=300
# Use echo only for testing Exotel connectivity without Meta or voice downloads.
CALL_MODE=meta
PREWARM_VOICES=1
MMS_TORCH_THREADS=4
MAX_CONCURRENT_CALLS=1
# Deliberately public hackathon judge line. Replace only if the test number changes.
JUDGES_PUBLIC_PHONE_E164=+917948504917
JUDGES_PUBLIC_VIDEO_URL=https://scrimba.com/explain/guide04lf97i2e?claim=j7oakcpcb1jsi5o4&fullscreen=1
# Optional opt-in PM-KISAN SMS recap. Keep unset until the Exotel sender and
# India DLT entity plus Hindi/English templates have been approved/configured.
EXOTEL_SMS_BASE_URL=https://api.in.exotel.com
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SMS_FROM=
